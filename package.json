{
  "name": "voice-satellite-card-integration",
  "version": "2026.9.13-fork.32",
  "description": "Voice Satellite for Home Assistant — turns browsers into Assist satellites.",
  "private": true,
  "scripts": {
    "test": "node --experimental-vm-modules --test tests/*.test.cjs",
    "prebuild": "node scripts/sync-version.js && node scripts/copy-fonts.js && node scripts/copy-vendor.js",
    "build": "webpack --mode production",
    "test:js": "node --test tests/js/*.test.mjs",
    "e2e:prepare": "python3 tests/e2e/run.py prepare",
    "e2e:up": "python3 tests/e2e/run.py up",
    "e2e:test": "python3 tests/e2e/run.py test",
    "e2e:down": "python3 tests/e2e/run.py down",
    "e2e:logs": "python3 tests/e2e/run.py logs",
    "e2e:open": "python3 tests/e2e/run.py open",
    "e2e:verify": "python3 tests/e2e/run.py verify",
    "predev": "node scripts/sync-version.js && node scripts/copy-fonts.js && node scripts/copy-vendor.js",
    "dev": "webpack --mode development && node scripts/deploy-ha.js",
    "convert:oww-onnx": "node scripts/convert-oww-tflite-to-onnx.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-loader": "^9.1.3",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "hls.js": "^1.6.16"
  }
}
